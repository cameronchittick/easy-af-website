# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the example must ship, or nobody who uses this template ever sees it.
!.env.example

# claude code personal overrides, never yours to distribute
.claude/settings.local.json

# .agents/skills/, skills-lock.json and the .claude/skills/ symlinks are the
# core of this template. They ARE the product and must be committed.
# Re-sync or update them with: npx skills add Leonxlnx/taste-skill

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# working notes and research. Local thinking, not part of the template someone
# else installs. Anything here that turns out to be load-bearing belongs in a
# skill or in AGENTS.md instead.
docs/
