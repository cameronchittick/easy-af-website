# Copy to .env.local for development. Both are optional — the site builds and
# runs without either, so you can deploy first and configure later.

# Your public site URL, no trailing slash. Feeds metadataBase, sitemap.xml and
# robots.txt. Without it those fall back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://example.com

# Where contact form submissions get POSTed as JSON. Any URL that accepts a
# webhook: Slack, Discord, Zapier, Make, or a form service. The body includes a
# `text` field for Slack/Discord, plus `name`, `email` and `message`.
# Unset means the form returns "not configured" instead of failing silently.
CONTACT_WEBHOOK_URL=
